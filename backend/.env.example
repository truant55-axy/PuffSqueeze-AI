APP_ENV=local
APP_TIMEZONE=Asia/Shanghai
DB_TIMEZONE=+08:00
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=puffsqueeze
DB_USER=root
DB_PASS=your_password

# Moodle table prefix. Keep empty if table names do not use prefix.
MOODLE_TABLE_PREFIX=

# Gemini API key for AI response
GEMINI_API_KEY=your_gemini_api_key

# Optional: allow frontend origin
ALLOWED_ORIGIN=http://localhost:3000

# For managed databases, use verify_identity and configure the provider CA.
DB_SSL_MODE=disabled
DB_SSL_CA=
