DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=moodle
DB_USER=root
DB_PASS=your_password

# Moodle table prefix. Keep empty if table names do not use prefix.
MOODLE_TABLE_PREFIX=

# Gemini API key for AI response
GEMINI_API_KEY=your_gemini_api_key

# Optional: allow frontend origin
ALLOWED_ORIGIN=http://localhost:3000
