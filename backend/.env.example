APP_ENV=production
APP_TIMEZONE=Asia/Shanghai
DB_TIMEZONE=+08:00
DB_HOST=your-tidb-host
DB_PORT=4000
DB_NAME=moodle
DB_USER=your-tidb-user
DB_PASSWORD=replace-with-a-render-secret

# Moodle table prefix. Keep empty if table names do not use prefix.
MOODLE_TABLE_PREFIX=

# Gemini API key for AI response
GEMINI_API_KEY=your_gemini_api_key
# Stable primary/fallback models keep chat and transcription working through transient 503s.
GEMINI_CHAT_MODEL=gemini-3.8-flash
GEMINI_CHAT_FALLBACK_MODEL=gemini-3.6-flash
GEMINI_TRANSCRIBE_MODEL=gemini-3.8-flash
GEMINI_TRANSCRIBE_FALLBACK_MODEL=gemini-3.6-flash

# Optional: enables authenticated users to clone their own voice and use it for speech.
# Keep this secret in Render; never expose it to Vite or commit a real value.
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5

# Neural voice synthesis module: absolute Python executable with requirements-voice.txt installed.
# Windows example: E:/path/to/PuffSqueeze-AI-main/.voice-venv/Scripts/python.exe
VOICE_PYTHON=

# Comma-separated exact origins. Do not add paths or a trailing slash.
ALLOWED_ORIGIN=https://puff-squeeze-ai.vercel.app

# For managed databases, use verify_identity and configure the provider CA.
DB_SSL_MODE=verify_identity
DB_SSL_CA=/etc/ssl/certs/ca-certificates.crt
