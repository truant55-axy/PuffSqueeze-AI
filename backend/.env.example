APP_ENV=production
APP_TIMEZONE=Asia/Shanghai
DB_TIMEZONE=+08:00
DB_HOST=your-tidb-host
DB_PORT=4000
DB_NAME=moodle
DB_USER=your-tidb-user
DB_PASSWORD=replace-with-a-render-secret

# Moodle table prefix. Keep empty if table names do not use prefix.
MOODLE_TABLE_PREFIX=

# Gemini API key for AI response
GEMINI_API_KEY=your_gemini_api_key
# Optional model override for short audio transcription.
GEMINI_TRANSCRIBE_MODEL=gemini-flash-latest

# Neural voice synthesis module: absolute Python executable with requirements-voice.txt installed.
# Windows example: E:/path/to/PuffSqueeze-AI-main/.voice-venv/Scripts/python.exe
VOICE_PYTHON=

# Comma-separated exact origins. Do not add paths or a trailing slash.
ALLOWED_ORIGIN=https://puff-squeeze-ai.vercel.app

# For managed databases, use verify_identity and configure the provider CA.
DB_SSL_MODE=verify_identity
DB_SSL_CA=/etc/ssl/certs/ca-certificates.crt
